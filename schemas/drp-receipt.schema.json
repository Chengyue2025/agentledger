{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Chengyue2025/agentledger/schemas/drp-receipt.schema.json",
  "title": "Agent Delegation Receipt body (draft-nelson-agent-delegation-receipts-13)",
  "description": "Closed top-level field set per Sections 4.2/4.3. Attached values (orchestratorSignature, receiptId, revoked, signature) are Section 4.4 values and MUST NOT appear in the signed body. Unknown top-level fields MUST be rejected (UNKNOWN_BODY_FIELD).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "delegationId",
    "issuedAt",
    "scope",
    "boundaries",
    "timeWindow",
    "operatorInstructions",
    "instructionsHash",
    "signerPublicKey"
  ],
  "properties": {
    "delegationId": { "type": "string", "minLength": 1 },
    "issuedAt": { "type": "string" },
    "scope": { "type": "string" },
    "boundaries": { "type": "string" },
    "timeWindow": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "string" },
        "end": { "type": "string" }
      }
    },
    "operatorInstructions": { "type": "string" },
    "instructionsHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "signerPublicKey": {
      "description": "Exactly kty/crv/x/y for ES256; MUST NOT carry private material.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kty", "crv", "x", "y"],
          "properties": {
            "kty": { "const": "EC" },
            "crv": { "const": "P-256" },
            "x": { "type": "string" },
            "y": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kty", "crv", "x"],
          "properties": {
            "kty": { "const": "OKP" },
            "crv": { "const": "Ed25519" },
            "x": { "type": "string" }
          }
        }
      ]
    },
    "agentId": { "type": "string" },
    "metadata": { "type": "object" },
    "toolSchemaHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "trustedSources": {
      "type": "array",
      "items": { "type": "string" }
    },
    "toolOutputHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "revocationRequired": { "type": "boolean" },
    "oneTimeUse": { "type": "boolean" },
    "parentReceiptId": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "authorityStateCommitment": { "type": "string" },
    "reauthPolicy": {},
    "nonce": { "type": "string" },
    "scopeSchema": {
      "type": "object",
      "required": ["allowedActions"],
      "properties": {
        "version": { "type": "string" },
        "allowedActions": { "$ref": "#/$defs/actions" },
        "deniedActions": { "$ref": "#/$defs/actions" },
        "maxDuration": { "type": "string" },
        "manifestHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  },
  "$defs": {
    "action": {
      "type": "object",
      "required": ["operation", "resource"],
      "properties": {
        "operation": { "type": "string" },
        "resource": { "type": "string" },
        "constraints": { "type": "object" }
      }
    },
    "actions": {
      "type": "array",
      "items": { "$ref": "#/$defs/action" }
    }
  }
}
